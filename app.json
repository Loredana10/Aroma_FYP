{
  "expo": {
    "name": "Aroma",
    "slug": "Aroma_FYP",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app_logo2.jpg",
    "scheme": "aromafyp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lb.aroma",
      "googleServicesFile": "./GoogleService-Info.plist",
      "config": {
        "googleMapsApiKey": "AIzaSyDsz1TvuJKba2UdMbEgrgNBJW89CcMJI6A"
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "package": "com.lb.aroma",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app_logo2.jpg",
        "backgroundColor": "#5C3317"
      },
      "notification": {
        "icon": "./assets/images/android-icon-monochrome.png",
        "color": "#C8A882"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDJDevRkFdgb0DcIdwlpa4hiyw0P1H4_os"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "runtimeVersion": "1.0.0"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#C8A882",
          "sounds": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/app_logo2.jpg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#5C3317",
          "dark": {
            "backgroundColor": "#5C3317"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Aroma needs your location to show nearby cafés.",
          "locationWhenInUsePermission": "Aroma needs your location to show nearby cafés."
        }
      ],
      "react-native-edge-to-edge"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "831ebffe-cca0-4b65-8b88-4643d4ceb6d9"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/831ebffe-cca0-4b65-8b88-4643d4ceb6d9"
    }
  }
}
